# Environment Configuration
APP_ENV=development
APP_CONFIG_PATH=config/config.yaml

# SAFETY: STRICTLY FALSE FOR PAPER TRADING
REAL_TRADING_ENABLED=false

# SERVER
PORT=8080
HOST=127.0.0.1

# DATABASE
DATABASE_URL=sqlite://data/poly_quant.db?mode=rwc

# REDIS (Optional for distributed cache, in-memory cache used by default)
# REDIS_URL=redis://127.0.0.1:6379/0

# LOGGING
RUST_LOG=info,poly_quant_backend=debug
